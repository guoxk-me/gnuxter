    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/robots": "6.1.4",
    "@nuxtjs/sitemap": "8.3.4",
    "@pinia/nuxt": "0.11.3",
    "@tailwindcss/vite": "^4.2.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
