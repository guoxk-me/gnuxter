  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "build": "nuxt build",
